# Copia este archivo como .env:  cp .env.example .env
# Nunca subas .env a GitHub (ya está en .gitignore).

# --- Base de datos (Docker Compose) ---
POSTGRES_USER=reservas
POSTGRES_PASSWORD=reservas
POSTGRES_DB=reservas

# --- Backend ---
ENVIRONMENT=development
# Para correr el backend fuera de Docker (en tu máquina), usa localhost:
DATABASE_URL=postgresql+psycopg://reservas:reservas@localhost:5432/reservas
CORS_ORIGINS=["http://localhost:5173"]

# --- Autenticación ---
# Obligatorio (mínimo 32 caracteres). Vacío, la API no arranca. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Opcionales (estos son los valores por defecto):
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
